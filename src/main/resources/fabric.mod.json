{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",

  "name": "${name}",
  "description": "Consolidates Minecraft configs, options, hotbars, schematics, resource packs and shader packs into a single shared master folder",
  "authors": [
    "asutarisucu"
  ],
  "contact": {
    "homepage": "https://github.com/asutarisucu/masterConfig",
    "sources": "https://github.com/asutarisucu/masterConfig",
    "issues": "https://github.com/asutarisucu/masterConfig/issues"
  },
  "license": "LGPL-3.0",

  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "org.asutarisucu.masterConfig.MasterConfigMod"
    ],
    "preLaunch": [
      "org.asutarisucu.masterConfig.MasterConfigPreLaunch"
    ]
  },
  "mixins": [
    "masterconfig.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.11.4",
    "minecraft": "${minecraft_dependency}"
  }
}
